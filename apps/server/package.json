    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^8.0.3",
    "dotenv": "^18.0.1",
    "fastify": "^5.2.0",
    "google-auth-library": "^11.1.0",
    "pino": "^9.5.0",
    "tesseract.js": "^5.1.1",
    "zod": "^3.24.1"
