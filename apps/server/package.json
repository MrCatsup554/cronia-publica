{
  "name": "@cronia/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor de OCR de Cronia: convierte imágenes de horarios en datos estructurados con Tesseract.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
